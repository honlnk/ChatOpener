<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".ChatOpenerApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChatOpener"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ChatOpener">

            <!-- 1) 从桌面图标启动：进入首页自选文件 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 2) 按扩展名匹配 content:// 与 file://（绝大多数文件管理器的“打开”走这里）。
                 pathPattern 的 .* 非贪婪匹配，路径中扩展名前每多一个点号就需要多一条
                 pattern 兜底（如 /Download/v1.5/记录.jsonl），此处按点数枚举到 3 个 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.jsonl" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\.jsonl" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\..*\\.jsonl" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\..*\\..*\\.jsonl" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.JSONL" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\.JSONL" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\..*\\.JSONL" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\..*\\..*\\.JSONL" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.jsonl" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\.jsonl" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\..*\\.jsonl" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\..*\\..*\\.jsonl" />
            </intent-filter>

            <!-- 3) 兜底：很多文件管理器只给 mime 不给扩展名。
                 application/json 是 .jsonl 最常见的泛化 mime；
                 octet-stream / text/plain 覆盖“未知类型”与按文本打开的管理器 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/json" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="file" android:mimeType="application/json" />
                <data android:scheme="file" android:mimeType="text/plain" />
            </intent-filter>

            <!-- 4) 接收“分享”来的 .jsonl 文件 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

        </activity>
    </application>
</manifest>
